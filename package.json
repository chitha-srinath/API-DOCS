{
  "name": "express-api-contract",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./manual": {
      "import": {
        "types": "./dist/manual.d.ts",
        "default": "./dist/manual.js"
      },
      "require": {
        "types": "./dist/manual.d.cts",
        "default": "./dist/manual.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "manual": [
        "./dist/manual.d.ts"
      ],
      "zod": [
        "./dist/zod.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./dist/auto-record.js",
    "./dist/auto-record.cjs",
    "src/introspect/auto-record.ts"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage --typecheck",
    "test:v4": "vitest run --coverage && npm run typecheck:v4",
    "typecheck:v4": "tsc --noEmit -p tsconfig.v4.json && vitest run --config vitest.typecheck.v4.config.ts",
    "lint": "eslint . && prettier --check .",
    "check:pack": "npm run build && publint && attw --pack .",
    "mutation": "stryker run",
    "perf": "vitest run --config vitest.perf.config.ts",
    "audit": "npm audit --audit-level=critical"
  },
  "peerDependencies": {
    "@types/express": "^4.17.21 || ^5.0.0",
    "express": "^4.21.0 || ^5.0.0",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@readme/openapi-parser": "^9.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@types/express": "5.0.6",
    "@types/node": "~22.20.4",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.2",
    "esbuild": "~0.27.7",
    "eslint": "10.11.0",
    "express": "^5.2.1",
    "express4": "npm:express@^4.22.3",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "supertest": "7.3.0",
    "tsup": "8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "^8.3.1",
    "vitest": "5.0.2",
    "yaml": "^2.6.0",
    "zod": "^4.6.5"
  }
}
